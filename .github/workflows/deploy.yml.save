with:
  host: ${{ secrets.HOST }}
  username: ubuntu
  key: ${{ secrets.SSH_KEY }}name: Deploy Task Tracker

on:
  push:
    branches:
      - main

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v3

    - name: Deploy to EC2
      uses: appleboy/ssh-action@master
      with:
        host: ${{ secrets.HOST }}
        username: ubuntu
        key: ${{ secrets.SSH_KEY }}
        script: |
          cd ~/task-tracker
          git pull origin main
          source venv/bin/activate
          pip install -r requirements.txt
          pip install gunicorn
          pkill gunicorn || true
          nohup gunicorn --bind 0.0.0.0:5000 app:app &
